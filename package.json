{
  "name": "league-history",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch-history.mjs",
    "build:data": "node scripts/build-stats.mjs",
    "refresh": "node scripts/fetch-history.mjs && node scripts/merge-history-dump.mjs && node scripts/build-stats.mjs",
    "dev": "next dev",
    "build": "next build && node scripts/verify-build.mjs",
    "start": "next start",
    "merge:history": "node scripts/merge-history-dump.mjs",
    "week": "node scripts/build-weekly.mjs",
    "players": "node scripts/build-player-map.mjs",
    "sync:achievements": "node scripts/sync-achievements.mjs",
    "test": "node scripts/achievements.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed-bettors.mjs",
    "db:check": "node --env-file=.env.local scripts/db-check.mjs",
    "test:book": "node --env-file=.env.local scripts/book.test.mjs",
    "test:odds": "node scripts/odds.test.mjs",
    "markets": "node --env-file=.env.local scripts/build-markets.mjs",
    "test:buyin": "node --env-file=.env.local scripts/buyin.test.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.3.2",
    "@neon/env": "^1.2.3",
    "@neondatabase/serverless": "^1.1.0",
    "next": "^16.3.4",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
}